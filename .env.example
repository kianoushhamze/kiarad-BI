KIARAD_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DB_HOST=postgres
DB_PORT=5432
DB_NAME=kiaradbi
DB_USER=kiarad
POSTGRES_PASSWORD=replace-with-a-unique-database-secret
PGADMIN_DEFAULT_EMAIL=admin@localhost
PGADMIN_DEFAULT_PASSWORD=replace-with-a-unique-admin-secret
HOLO_API_URL=http://192.168.1.1:8080/TncHoloo/api
HOLO_USERNAME=web
HOLO_PASSWORD=replace-with-holoo-password
HOLO_AUTO_REFRESH_ENABLED=1
HOLO_AUTO_REFRESH_SECONDS=300

# Optional specialist assistant and live market search (configure secrets on server).
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
TAVILY_API_KEY=
# Staged installations force both schedulers off until acceptance.
KIARAD_AUTOMATIONS_DISABLED=1
KIARAD_AGENT_DISABLED=1

# Reviewed recurring workflows: disabled until company acceptance.
KIARAD_ROUTINES_DISABLED=1
KIARAD_OUTBOUND_ENABLED=0
KIARAD_OUTBOUND_DAILY_LIMIT=100
# Configure on company server only; never commit credentials.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KIARAD_SMTP_HOST=
KIARAD_SMTP_PORT=587
KIARAD_SMTP_USER=
KIARAD_SMTP_PASSWORD=
KIARAD_SMTP_FROM=

# Optional GPS gateway: setup script generates the private forwarding credential.
KIARAD_TRACCAR_ENABLED=0
KIARAD_TRACCAR_FORWARD_TOKEN=
KIARAD_TRACCAR_CLIENT_URL=
